{
  "name": "cmd-mesh",
  "version": "0.5.0",
  "description": "ArkType-typed command mesh: one declarative program model, invocable as a CLI, as an MCP server, or as plain typed functions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/cmd-mesh.git",
    "directory": "packages/cmd-mesh"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "skill-data",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:cost && pnpm run test:types && pnpm run check:pack",
    "check:pack": "pnpm run build && publint && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:cost": "vitest run --config vitest.cost.config.ts",
    "test:types": "tsx contract.attest.ts && tsx typed-functions.attest.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ark/util": "0.56.2",
    "@bomb.sh/tab": "^0.0.22",
    "@clack/prompts": "^1.7.0",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "arktype": "catalog:",
    "effect": "catalog:",
    "nostics": "^1.2.0",
    "package-management": "^0.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ark/attest": "catalog:",
    "@effect/vitest": "catalog:",
    "publint": "^0.3.24",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
