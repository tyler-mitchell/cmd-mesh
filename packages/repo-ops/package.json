{
  "name": "repo-ops",
  "version": "0.0.0",
  "private": true,
  "description": "The closed-distribution repository operations (Bumpy release procedure, CI runs, dependabot PRs) as mountable cmd-mesh modules.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "cmd-mesh": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
