{
  "name": "@command-mesh/spec",
  "version": "0.0.0",
  "private": true,
  "description": "Fig-inspired command specification with ArkType semantics.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
